  "workflowDeps": {
    "_comment": "9阶段工作流DAG（对齐 LangGraph StateGraph / Agency Orchestrator depends_on）。humanInLoop=鸡(评审)一票否决。可由程序校验阶段依赖与并行关系。",
    "phases": [
      {
        "id": "P1",
        "name": "需求分析",
        "owner": "rat-product-researcher",
        "depends_on": []
      },
      {
        "id": "P2",
        "name": "市场调研",
        "owner": [
          "tiger-image-collector",
          "rabbit-image-analyst",
          "dragon-competitor-analyst"
        ],
        "depends_on": [
          "P1"
        ],
        "parallel": true
      },
      {
        "id": "P3",
        "name": "产品设计",
        "owner": "snake-product-designer",
        "depends_on": [
          "P2"
        ]
      },
      {
        "id": "P4",
        "name": "成本/标准分析",
        "owner": "ox-standards-analyst",
        "depends_on": [
          "P3"
        ]
      },
      {
        "id": "P5",
        "name": "AI生图",
        "owner": [
          "horse-rendering-expert",
          "goat-ai-image-generator",
          "monkey-skill-optimizer"
        ],
        "depends_on": [
          "P4"
        ],
        "parallel": true
      },
      {
        "id": "P6",
        "name": "设计评审(质量门禁)",
        "owner": "rooster-design-reviewer",
        "depends_on": [
          "P5"
        ],
        "humanInLoop": true
      },
      {
        "id": "P7",
        "name": "品牌设计",
        "owner": "pig-brand-designer",
        "depends_on": [
          "P6"
        ]
      },
      {
        "id": "P8",
        "name": "情报收集(持续)",
        "owner": "dog-cost-analyst",
        "depends_on": [
          "P1"
        ],
        "continuous": true
      },
      {
        "id": "P9",
        "name": "最终输出整合",
        "owner": "rat-product-researcher",
        "depends_on": [
          "P7",
          "P8"
        ]
      }
    ]
  },
  "observability": {
    "_comment": "运行态可观测性契约（对齐 OpenTelemetry GenAI Semantic Conventions + AgentOps span 模型）。主机运行时接入 tracing hook 前，先以结构化事件流(JSONL)落地最小可用可观测栈：trace_id+session_id 串联、按 agent/phase/event_type 聚合、脱敏后回放。引擎见 zodiac-team/scripts/trace.js，契约说明见 docs/OBSERVABILITY.md。",
    "enabled": true,
    "schemaVersion": "otel-genai-1.0",
    "sink": "logs/zodiac_traces.jsonl",
    "truncateChars": 500,
    "spanKinds": [
      "SESSION",
      "AGENT",
      "WORKFLOW",
      "OPERATION",
      "LLM",
      "TOOL"
    ],
    "phasesRef": "workflowDeps.phases",
    "eventTypes": {
      "session_start": "一次完整任务会话开始（鼠接收需求）",
      "phase_enter": "进入某 workflowDeps 阶段",
      "agent_dispatch": "鼠路由分发至某生肖专家",
      "routing_decision": "路由/调度决策（含依据）",
      "tool_call": "专家调用工具/技能（参数摘要+结果状态+耗时）",
      "review_gate": "鸡质量门禁评审（通过/否决+依据）",
      "error": "执行异常（错误类型+恢复动作）",
      "phase_complete": "阶段完成",
      "session_end": "会话结束（总耗时/总步数/成功与否）"
    },
    "requiredFields": [
      "trace_id",
      "session_id",
      "ts",
      "agent",
      "phase",
      "span_kind",
      "event_type",
      "status"
    ],
    "optionalFields": [
      "latency_ms",
      "cost_usd",
      "tokens_in",
      "tokens_out",
      "retry_count",
      "decision",
      "guardrail_hit",
      "attributes"
    ]
  },
  "learnings": {
