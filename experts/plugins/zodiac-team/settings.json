    "en": "Full expert ecosystem linkage engine - all 30+ experts cross-linked to the Zodiac Team for unified collaboration and mutual referral.",
    "zh": "全专家生态连锁引擎 — 所有30+位专家与生肖团实现双向连锁，构建统一协作网络"
  },
  "mcpServers": {
    "_说明": "MCP 真实配置在 ~/.workbuddy/mcp.json（单一真源，勿在此重复维护）。",
    "_已配置": [
      "tavily（语义搜索）",
      "agent-reach（联网眼 16 通道）"
    ],
    "_新增方式": "在 ~/.workbuddy/mcp.json 的 mcpServers 下追加，然后在 WorkBuddy 连接器页点「信任」"
  },
  "env": {
    "_说明": "环境变量键位契约（值留空）。真实值放 .env 或系统环境变量，禁写此文件（会随框架分发）。",
    "_样例": ".env.example（在本目录）",
    "OPENAI_API_KEY": "",
    "OPENAI_BASE_URL": "",
    "DASHSCOPE_API_KEY": "",
    "DASHSCOPE_BASE_URL": "",
    "ANTHROPIC_API_KEY": "",
    "OLLAMA_BASE_URL": "",
    "VLM_MODEL": "",
    "COMFYUI_ROOT": "",
    "ZODIAC_BUS_LOG_DIR": "",
    "OCTOP_HOST": "127.0.0.1",
    "OCTOP_PORT": "8088"
  },
  "rules": [
    "生肖创新团为唯一核心代理人（唯一对外入口），总调度中心，所有跨界调度必经鼠（主理人）",
    "执行层（生肖技能）与顾问层（外部专家）双向联动",
    "执行层遇到超出自身能力的问题时，调用对应的专家包作为顾问",
    "顾问层给出建议后，需要执行落地时，调用对应的生肖技能作为执行工具",
    "智数分析专家团(ai-data-copilot)和design-engine作为子团体与生肖团绑定联动",
    "软件公司(software-company)、前端后端(frontend-backend)等技术团队可通过龙/猴/马转接",
    "全专家网络通过linkageMap实现自动发现和互访",
    "产品视觉生产链路（APVPS 溶解）：需求经羊(造底)→马(渲染)→猴(调参)→鸡(门禁)，质量门禁必经鸡(四维门禁)；商用权重禁 FLUX.1-dev(E006)"
  ],
